{
  "suite_id": "xiaoba-jev-parallel-delegation-v0.3",
  "repo": "fightheyyy/XIAOBA",
  "status": "ready",
  "scope": "live current XiaoBa Main vs live Main + parallel Jev; mock child execution only; no failover experiment",
  "models": {
    "A": "current XiaoBa Main tools; gpt-5.6-luna(low)",
    "B": "same Main with send_text/send_file only + independent parallel jev-1.13-free"
  },
  "rules": {
    "input_events": "route only authentic new user messages, never internal subagent results",
    "role_choices": [
      "none",
      "engineer-cat",
      "browser-cat",
      "gui-cat",
      "secretary-cat",
      "evolution-cat",
      "inspector-cat",
      "reviewer-cat"
    ],
    "runs_per_case": 1,
    "cost_measure": "raw provider usage including cached/reasoning tokens; no inferred monetary savings",
    "latency_measure": "wall-clock ingress -> first and last successful visible delivery; missing deliveries are null; last delivery does not imply correct completion; child mock delay is 500 ms after its model call starts",
    "mock": "scripted SubAgent responses only; Main and Jev real; do not claim true task completion",
    "safety": "Main delivery never waits for Jev. Claims must match known runtime facts; mock results cannot be presented as real execution.",
    "evaluation_scope": "ordinary replies, contextual no-delegation, clear single-role tasks only; stop/steer/resume and multi-role/confirmed writes excluded until explicit actions are designed"
  },
